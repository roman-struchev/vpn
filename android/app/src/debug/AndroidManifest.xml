<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged only into debug (and, by extension, androidTest, which targets the
  debug build type) builds — release keeps the main manifest's
  usesCleartextTraffic="false" untouched. See network_security_config_debug.xml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:usesCleartextTraffic,android:networkSecurityConfig" />
</manifest>
