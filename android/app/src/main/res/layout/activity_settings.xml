<?xml version="1.0" encoding="utf-8"?>
<!--
  Connection settings, moved off the connect screen (which had grown to eight
  stacked blocks). Both controls here are decided once per install and then
  never touched again, so they do not belong next to the connect button —
  but the RU route is this product's differentiating feature for Russian
  users, so the connect screen keeps a one-line summary that opens this.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:layout_marginBottom="16dp" />

        <!-- Only relevant to a user actually in Russia, or a Russian-speaking
             user abroad — SettingsActivity hides this block otherwise (see
             GeoLocale). -->
        <LinearLayout
            android:id="@+id/russianRoutingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/russian_routing_title"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/russianRoutingToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/russianRoutingOffButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/russian_routing_off" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/russianRoutingBypassButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/russian_routing_bypass" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/russianRoutingOnlyRuButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/russian_routing_only_ru" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/russianRoutingDescText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <TextView
                android:id="@+id/russianRoutingWarningText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/russian_routing_no_ru_node_warning"
                android:textColor="@color/state_reconnecting"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:background="?attr/colorOutlineVariant" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/autoBootSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_boot_title" />
    </LinearLayout>
</ScrollView>
