<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/p2p_relay_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/p2p_relay_explanation"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/p2pTermsLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/p2p_relay_terms_link"
            android:textColor="?attr/colorPrimary"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/p2pAcceptCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/p2p_relay_accept_checkbox"
            android:layout_marginBottom="16dp" />

        <!-- The relay NODE's own physical location — geo-IP auto-detected once
             by P2pRelayAgent#start on first-ever registration (the repo owner's
             explicit call: "как при старте ноды", the same one-shot detection a
             regular VPS node does at install time), never editable here.
             Invisible until a value is actually known (see
             P2pRelaySettingsActivity#onCreate) — unrelated to any VPN-connection
             region preference elsewhere in the app. -->
        <TextView
            android:id="@+id/p2pRegionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/p2p_relay_mode_label"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/p2pModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/p2pModeOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/p2p_relay_mode_off"
                android:checked="true" />

            <RadioButton
                android:id="@+id/p2pMode1h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/p2p_relay_mode_1h" />

            <RadioButton
                android:id="@+id/p2pMode8h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/p2p_relay_mode_8h" />

            <RadioButton
                android:id="@+id/p2pModeAlways"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/p2p_relay_mode_always" />

        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/p2pApplyButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/p2p_relay_apply" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/p2p_relay_status_label"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/p2pStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

    </LinearLayout>

</ScrollView>
