    <string name="p2p_relay_unsupported_title">Relaying isn\u2019t supported on this network</string>
    <string name="p2p_relay_unsupported_symmetric">Your provider (almost every mobile carrier does this) doesn\u2019t let direct connections reach this device, so nobody could connect through it. On another network \u2014 home Wi\u2011Fi, say \u2014 relaying may work.</string>
    <string name="p2p_relay_unsupported_no_udp">UDP is blocked on this network, and direct connections to this device need it. On another network \u2014 home Wi\u2011Fi, say \u2014 relaying may work.</string>
