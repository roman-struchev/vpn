<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher background was a flat #060709 — near-black. Among a screenful
  of colourful icons that reads as a hole rather than an icon, and on a dark
  wallpaper it disappears outright. Brand green instead, with a light-to-dark
  diagonal so the mask's rounded corners have something to catch.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#2EDB6B" />
                <item android:offset="0.55" android:color="#22C55E" />
                <item android:offset="1" android:color="#15803D" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
